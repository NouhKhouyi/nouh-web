---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import TransitMap from './TransitMap.astro';
import Work from './Work.astro';
import portrait from '../assets/portrait.jpg';
import { ui, workRows, studyRows, toolkit, languages, about, EMAIL, GITHUB, LINKEDIN, type Lang } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const year = new Date().getFullYear();
---

<Base lang={lang}>
  <div class="wrap">
    <Header lang={lang} />

    <main id="main">
      <section class="hero" aria-labelledby="name">
        <div class="intro">
          <h1 id="name">Nouh Khouyi Etbar <span>{t.role}</span></h1>
          <div>
            <p class="thesis">{t.thesis}</p>
            <p class="status">{t.status}</p>
          </div>
          <div class="legend">
            <span class="chip ai"><span class="chip-t">{t.lines.ai}</span></span>
            <span class="chip mob"><span class="chip-t">{t.lines.mob}</span></span>
            <span class="chip com"><span class="chip-t">{t.lines.com}</span></span>
            <p>{t.legendHint}</p>
          </div>
        </div>
        <TransitMap lang={lang} />
      </section>

      <Work lang={lang} />

      <section class="block" id="experience" aria-labelledby="exp-h">
        <div class="head">
          <h2 id="exp-h">{t.expTitle}</h2>
          <p>{t.expIntro}</p>
        </div>
        <div class="tables">
          <table class="tt">
            <caption>{t.workTable}</caption>
            <tbody>
              {workRows[lang].map((r) => (
                <tr>
                  <th scope="row">{r.when}</th>
                  <td><b>{r.title}</b> <span class="org">{r.org}</span>{r.text && ` ${r.text}`}</td>
                  <td class="c">{r.line && <span class={`chip ${r.line}`}><span class="chip-t">{t.lines[r.line]}</span></span>}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <table class="tt">
            <caption>{t.studyTable}</caption>
            <tbody>
              {studyRows[lang].map((r) => (
                <tr>
                  <th scope="row">{r.when}</th>
                  <td><b>{r.title}</b> <span class="org">{r.org}</span>{r.text && ` ${r.text}`}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <div>
            <h3 class="kit-h">{t.toolkit}</h3>
            <dl class="kit">
              {toolkit[lang].map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
            </dl>
          </div>
        </div>
      </section>

      <section class="block" id="about" aria-labelledby="about-h">
        <div class="head"><h2 id="about-h">{t.aboutTitle}</h2></div>
        <div class="about">
          <Picture src={portrait} formats={['avif', 'webp']} widths={[360, 720, 1080]} sizes="(max-width: 820px) 280px, 360px" alt={t.photoAlt} class="photo" loading="lazy" decoding="async" />
          <div>
            <div class="prose">
              {about[lang].map((p) => <p>{p}</p>)}
            </div>
            <ul class="langs" aria-label={t.langsLabel}>
              {languages[lang].map(([l, v]) => <li><span>{l}</span><span>{v}</span></li>)}
            </ul>
          </div>
        </div>
      </section>

      <section class="contact" id="contact" aria-labelledby="contact-h">
        <h2 id="contact-h">{t.contactTitle}</h2>
        <p class="lede">{t.contactLede}</p>
        <div class="mail">
          <a id="email" href={`mailto:${EMAIL}`}>{EMAIL}</a>
          <button class="btn" id="copy" type="button" data-copied={t.copied} data-fallback={t.copyFallback}>{t.copy}</button>
        </div>
        <div class="links">
          <a href={GITHUB} rel="me">GitHub</a>
          <a href={LINKEDIN} rel="me">LinkedIn</a>
        </div>
      </section>
    </main>

    <footer class="foot">
      <span>© {year} Nouh Khouyi Etbar</span>
      <span>{t.footer}</span>
    </footer>
  </div>
</Base>

<script>
  const copy = document.getElementById('copy') as HTMLButtonElement | null;
  const mail = document.getElementById('email');
  if (copy && mail) {
    const label = copy.textContent;
    copy.addEventListener('click', () => {
      const fallback = () => {
        const r = document.createRange();
        r.selectNodeContents(mail);
        const sel = window.getSelection();
        sel?.removeAllRanges();
        sel?.addRange(r);
        copy.textContent = copy.dataset.fallback || '';
      };
      if (!navigator.clipboard) return fallback();
      navigator.clipboard.writeText(mail.textContent || '').then(() => {
        copy.textContent = copy.dataset.copied || '';
        setTimeout(() => (copy.textContent = label), 2000);
      }, fallback);
    });
  }
</script>
